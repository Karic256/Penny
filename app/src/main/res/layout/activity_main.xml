<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/penny_cream">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@color/penny_green_dark"
        android:paddingLeft="20dp" android:paddingTop="22dp" android:paddingRight="20dp" android:paddingBottom="22dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Penny" android:textColor="@color/white" android:textStyle="bold" android:textSize="30sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Your money, automatically understood." android:textColor="#D1FAE5" android:textSize="14sp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg">
                <TextView android:text="THIS MONTH" android:textColor="#647067" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/txtBalance" android:text="UGX 0" android:textColor="@color/text_primary" android:textSize="32sp" android:textStyle="bold" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
                    <TextView android:id="@+id/txtIncome" android:text="Income\nUGX 0" android:textColor="@color/penny_green" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txtExpense" android:text="Spent\nUGX 0" android:textColor="@color/penny_red" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/txtPrivacy" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:background="@drawable/card_bg" android:text="🔒 Penny works locally. Your messages and financial records are not uploaded." android:textColor="@color/text_primary" android:textSize="14sp"/>

            <TextView android:id="@+id/txtPermissionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="SMS access is required for automatic tracking" android:textColor="#647067" android:textSize="13sp"/>

            <Button android:id="@+id/btnPermission" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/primary_button" android:text="Allow SMS access" android:textAllCaps="false" android:textColor="@color/white" android:textStyle="bold"/>
            <Button android:id="@+id/btnImport" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Import financial SMS" android:textAllCaps="false"/>
            <Button android:id="@+id/btnEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Import email receipt" android:textAllCaps="false"/>
            <Button android:id="@+id/btnExport" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Export CSV backup" android:textAllCaps="false"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Recent transactions" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:id="@+id/txtEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:text="No transactions yet. Grant SMS access and import your alerts." android:textColor="#647067" android:gravity="center"/>
            <LinearLayout android:id="@+id/transactionList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
